<odoo>
    <!-- Action -->
    <record id="action_repair_profit" model="ir.actions.act_window">
        <field name="name">Repair Profitability</field>
        <field name="res_model">repair.batch</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_repair_profit_list"/>
        <field name="domain">[('state', '=', 'done')]</field>
        <field name="context">{'create': 0, 'edit': 0, 'delete': 0}</field>
    </record>

    <record id="view_repair_profit_list" model="ir.ui.view">
        <field name="name">repair.batch.profit.list</field>
        <field name="model">repair.batch</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="create_date desc">
                <field name="name" />
                <field name="sale_id" />
                <field name="partner_id" />
                <field name="total_cost" />
                <field name="sale_amount" />
                <field name="profit" />
            </list>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_repair_profit_root" name="Repair Profitability"
    parent="repair_batch.menu_repair_root"
    groups="repair_batch.group_repair_head" sequence="20" />

    <menuitem id="menu_repair_profit" name="Profit Report" parent="menu_repair_profit_root"
    action="action_repair_profit" groups="repair_batch.group_repair_head" />
</odoo>
