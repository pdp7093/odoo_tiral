<odoo>

    <record id="view_sale_order_form_inherit_repair" model="ir.ui.view">
        <field name="name">sale.order.form.repair</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Repair Checkbox -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_repair_order"/>
            </xpath>

            <!-- Smart Button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_repair_batches"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-wrench">

                    <field name="repair_count" widget="statinfo" string="Repairs"/>
                </button>
            </xpath>

        </field>
    </record>

</odoo>