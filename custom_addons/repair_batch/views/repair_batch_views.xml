<odoo>

    <!-- ================= ACTION ================= -->
    <record id="action_repair_batch" model="ir.actions.act_window">
        <field name="name">Repair Batches</field>
        <field name="res_model">repair.batch</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================= MENU ================= -->
    <menuitem id="menu_repair_root"
        name="Repair Management"
        sequence="10" />

    <menuitem id="menu_repair_batch"
        name="Repair Batches"
        parent="menu_repair_root"
        action="action_repair_batch"
        sequence="1" />

    <!-- ================= LIST VIEW ================= -->
    <record id="view_repair_batch_list" model="ir.ui.view">
        <field name="name">repair.batch.list</field>
        <field name="model">repair.batch</field>
        <field name="arch" type="xml">
            <list default_order="create_date desc">
                <field name="name" />
                <field name="partner_id" />
                <field name="state" />
                <field name="received" />
            </list>
        </field>
    </record>

    <!-- ================= MAIN FORM ================= -->
    <record id="view_repair_batch_form" model="ir.ui.view">
        <field name="name">repair.batch.form</field>
        <field name="model">repair.batch</field>
        <field name="arch" type="xml">

            <form>
                <header>

                    <button name="action_approve" type="object" string="Approve" invisible="state != 'to_approve'" />

                    <button name="action_reject" type="object" string="Reject" invisible="state != 'to_approve'" />

                    <button name="action_receive"
                        type="object"
                        string="Receive"
                        invisible="state != 'draft'" />

                    <button name="action_start_repair"
                        type="object"
                        string="Start Repair"
                        invisible="state != 'ready'" />

                    <button name="action_done"
                        type="object"
                        string="Mark Done"
                        invisible="state != 'in_progress'" />

                    <field name="state" widget="statusbar" />
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text"
                            invisible="not invoice_id or state != 'done'">
                            <field name="invoice_id" widget="statinfo" string="Invoice" />
                        </button>
                    </div>

                    <group>
                        <field name="sale_id" />
                        <field name="name" />
                        <field name="partner_id" />
                        <field name="received" />

                       
                    </group>

                    <notebook>

                        <!-- ================= TROLLEYS ================= -->
                        <page string="Trolleys">

                            <field name="trolley_ids"
                                context="{'form_view_ref': 'repair_batch.view_repair_trolley_form'}">

                                <list editable="bottom" open_form_view="1" create="true"
                                    delete="true">
                                    <field name="is_done" widget="boolean_toggle" />
                                    <field name="name" />
                                    <field name="employee_id" />
                                    <field name="state" />
                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>
            </form>

        </field>
    </record>

    <!-- ================= TROLLEY FORM ================= -->
    <record id="view_repair_trolley_form" model="ir.ui.view">
        <field name="name">repair.trolley.form</field>
        <field name="model">repair.trolley</field>
        <field name="arch" type="xml">

            <form>
                <sheet>

                    <group>
                        <field name="name" />
                        <field name="batch_id" invisible="1" />
                        <field name="state" readonly="1" />
                    </group>

                    <!-- ================= WORK LINES ================= -->
                    <field name="work_line_ids">

                        <!-- editable allowed here -->
                        <list editable="bottom">
                            <field name="is_done" />
                            <field name="product_id" />
                            <field name="quantity" />
                        </list>

                    </field>

                </sheet>
            </form>

        </field>
    </record>

</odoo>